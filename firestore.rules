rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  function admin(){return signed() && request.auth.token.admin == true;}
  match /products/{id} { allow read: if true; allow write: if admin(); }
  match /materials/{id} { allow read,write: if admin(); }
  match /orders/{id} {
   allow create: if signed();
   allow read: if admin() || (signed() && resource.data.ownerUid == request.auth.uid);
   allow update: if admin();
   allow delete: if admin();
  }
  match /production/{id} { allow create: if true; allow read: if admin() || (signed() && resource.data.ownerUid == request.auth.uid); allow update,delete: if admin(); }
  match /contacts/{id} { allow read,write: if admin(); }
  match /activities/{id} { allow read: if admin(); allow create: if signed(); allow update,delete: if admin(); }
 }
}