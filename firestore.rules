rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  function admin(){return signed() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked != true;}
  match /users/{uid}{
   allow create: if signed() && request.auth.uid==uid && request.resource.data.role=='buyer' && request.resource.data.blocked==false;
   allow read: if signed() && (request.auth.uid==uid || admin());
   allow update: if admin() || (signed() && request.auth.uid==uid && request.resource.data.role==resource.data.role && request.resource.data.blocked==resource.data.blocked && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','photoURL','lastLoginAt']));
   allow delete: if admin();
  }
  match /orders/{id}{allow create: if signed() && request.resource.data.uid==request.auth.uid;allow read: if admin() || (signed() && resource.data.uid==request.auth.uid);allow update,delete: if admin();}
  match /requests/{id}{allow create: if signed() && request.resource.data.uid==request.auth.uid;allow read,update,delete: if admin();}
  match /products/{id}{allow read: if true;allow write: if admin();}
 }
}